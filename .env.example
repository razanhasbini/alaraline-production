# Copy to .env.local (never committed).

# The WordPress + WooCommerce backend.
WC_URL=https://alaraline.co

# Read-only WooCommerce REST key. Server-only: used for product tabs (Ingredients, How to Use),
# which the public Store API does not return. Create in WooCommerce → Settings → Advanced → REST API, permission "Read".
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Local preview only: use saved live data when the ÀLara Headless API plugin is not installed yet.
# ALARA_SNAPSHOTS=1

# Admin panel: random secret (32+ characters) used to encrypt the login cookie, e.g. `openssl rand -base64 36`.
ADMIN_SESSION_SECRET=

# Placing orders is off while WC_URL is the live shop. Set to 1 only at cutover.
ALLOW_LIVE_CHECKOUT=
# Admin panel: Read/Write WooCommerce REST key (server only)
WC_ADMIN_KEY=
WC_ADMIN_SECRET=
# Admin sign-ins, made with: node scripts/admin-user.mjs <user> <password> [Name]
ADMIN_USERS=
# 1 = use saved bundle/results data if the shop plugin isn't installed
ALARA_SNAPSHOTS=
